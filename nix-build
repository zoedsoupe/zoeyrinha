#! /bin/zsh

if (( # == 0 )); then
  print >&2 "Usage: $0 personal | iso | yby-iso | yby | eveo"
  exit 1
fi

case "$1" in
  "personal")
     if ! type darwin-rebuild > /dev/null; then
       nix --extra-experimental-features "nix-command flakes" run nix-darwin/nix-darwin-25.05#darwin-rebuild -- switch --flake .#zoedsoupe-mac
     else
       darwin-rebuild switch --show-trace --flake .#zoedsoupe-mac
     fi
     ;;

  "iso")
    nix build .#nixosConfigurations.minimal-iso.config.system.build.isoImage "${@:2}"
    ;;

  # installer ISO carrying the yby flake + ZFS tooling; flash to USB, then on
  # the target: copy the flake writable, add the generated hardware-config and
  # nixos-install --flake /tmp/zoeyrinha#yby
  "yby-iso")
    nix build .#nixosConfigurations.yby-iso.config.system.build.isoImage "${@:2}"
    ;;

  # build-only checks; x86_64-linux builds need a linux builder,
  # run on the target machine itself if none is configured
  "yby"|"eveo")
    nix build ".#nixosConfigurations.$1.config.system.build.toplevel" "${@:2}"
    ;;

  *)
    print >&2 "Available options are, \"personal\" \"iso\" \"yby-iso\" \"yby\" \"eveo\" for now"
    exit 1
    ;;
esac
